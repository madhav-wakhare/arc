# Copy to .env and edit.

# Absolute path of your Obsidian vault on this Mac.
OBSIDIAN_VAULT_PATH=/Users/you/Documents/ObsidianVault

# Folder inside the vault for exported links (can also be changed in Settings).
OBSIDIAN_FOLDER=Smriti/Videos

# Your time zone (used for "today", daily reviews and reports).
TZ=Asia/Kolkata

# Port on this Mac. Use SMRITI_BIND=127.0.0.1 to block access from other devices.
SMRITI_PORT=8080
SMRITI_BIND=0.0.0.0

# macOS notifications (make notify-install). Day: 0 = Sunday ... 5 = Friday.
SMRITI_MORNING_TIME=09:00
SMRITI_WEEKLY_DAY=5
SMRITI_WEEKLY_TIME=18:00
